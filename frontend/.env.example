# Existing project; supply its web app configuration locally.
REACT_APP_FIREBASE_PROJECT_ID=njms-tb-image-study
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=njms-tb-image-study.firebaseapp.com
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
# Set explicitly to the database used by this deployment.
REACT_APP_FIREBASE_DATABASE_ID=capricorn-dev
# Populate with your own staged service URLs. No upstream URL fallback.
REACT_APP_CHAT_URL=
REACT_APP_REDACT_URL=
REACT_APP_PROCESS_LAB_URL=
REACT_APP_RETRIEVE_ARTICLES_URL=
REACT_APP_FINAL_ANALYSIS_URL=
REACT_APP_FEEDBACK_URL=
REACT_APP_EXTRACT_DISEASE_URL=
REACT_APP_EXTRACT_EVENTS_URL=
REACT_APP_DETECT_SPECIALTY_URL=
# Optional legacy endpoints (templates URL is the collection endpoint).
REACT_APP_GENERATE_CASE_URL=
REACT_APP_TEMPLATES_URL=
# Approved research configuration: one displayed article maximum.
# The runtime hard cap remains one even if environment values are raised.
REACT_APP_DEFAULT_ARTICLES=1
REACT_APP_MAX_ARTICLES=1

REACT_APP_ANALYZE_IMAGE_URL=
